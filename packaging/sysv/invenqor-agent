#!/bin/sh
### BEGIN INIT INFO
# Provides:          invenqor-agent
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Invenqor asset inventory agent
### END INIT INFO

NAME=invenqor-agent
DAEMON=/opt/invenqor-agent/bin/invenqor-agent
CONFIG=/etc/invenqor-agent/config.toml
PIDFILE=/var/run/invenqor-agent.pid
USER=invenqor-agent

# systemd installs a path unit that applies a staged update as soon as it
# appears. SysV has no equivalent, so apply it here, where the script already
# runs as root. Without this an update stages forever and never installs.
apply_staged_update() {
    if [ -e /var/lib/invenqor-agent/updates/pending.json ]; then
        echo "Applying staged $NAME update"
        "$DAEMON" --config "$CONFIG" --apply-pending-update ||
            echo "Staged update was not applied" >&2
    fi
}

start_agent() {
    apply_staged_update
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon --start --quiet --background --make-pidfile \
            --pidfile "$PIDFILE" --chuid "$USER" --exec "$DAEMON" -- \
            --config "$CONFIG"
    elif command -v daemon >/dev/null 2>&1; then
        daemon --user "$USER" --pidfile "$PIDFILE" \
            "$DAEMON --config $CONFIG"
    else
        echo "No supported service launcher found" >&2
        return 1
    fi
}

stop_agent() {
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon --stop --quiet --retry TERM/30/KILL/5 \
            --pidfile "$PIDFILE" --exec "$DAEMON"
        rm -f "$PIDFILE"
    elif [ -r "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")"
        rm -f "$PIDFILE"
    fi
}

case "${1:-}" in
    start) start_agent ;;
    stop) stop_agent ;;
    restart) stop_agent; start_agent ;;
    status)
        if [ -r "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "$NAME is running"
        else
            echo "$NAME is stopped"
            exit 3
        fi
        ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 2 ;;
esac

